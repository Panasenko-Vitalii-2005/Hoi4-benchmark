<UserControl x:Class="HOI4Benchmark.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0">
    <TextBlock
        Text="{Binding Title}"
        Style="{StaticResource PageTitleTextStyle}" />

    <TextBlock
        Margin="0,8,0,0"
        Text="{Binding Subtitle}"
        Style="{StaticResource PageSubtitleTextStyle}" />
</StackPanel>

                <Button Grid.Column="1"
                        Width="110"
                        Height="38"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Summary cards -->

            <Grid Grid.Row="1"
                  Margin="0,32,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Total results"
                                   Foreground="#687386"
                                   FontSize="14"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding TotalResults}"
                                   Foreground="#1E2430"
                                   FontWeight="Bold"
                                   FontSize="28"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Best score"
                                   Foreground="#687386"
                                   FontSize="14"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding BestScore}"
                                   Foreground="#1E2430"
                                   FontWeight="Bold"
                                   FontSize="28"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Last benchmark"
                                   Foreground="#687386"
                                   FontSize="14"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding LastBenchmark}"
                                   Foreground="#1E2430"
                                   FontWeight="SemiBold"
                                   FontSize="18"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- System information -->

            <Border Grid.Row="2"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="System information"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Processor"
                                   Foreground="#687386"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding ProcessorName}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1"
                                   Margin="0,14,0,0"
                                   Text="Graphics"
                                   Foreground="#687386"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Text="{Binding GraphicsAdapter}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,0"
                                   Text="Memory"
                                   Foreground="#687386"/>

                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Text="{Binding InstalledMemory}"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="3"
                                   Margin="0,14,0,0"
                                   Text="Operating system"
                                   Foreground="#687386"/>

                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Margin="0,14,0,0"
                                   Text="{Binding OperatingSystem}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Start benchmark -->

            <Border Grid.Row="3"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#26344A"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Ready to benchmark?"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>

                        <TextBlock Margin="0,8,0,0"
                                   Text="Start a new Hearts of Iron IV performance measurement session."
                                   Foreground="#C8D0DC"
                                   FontSize="14"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Width="150"
                            Height="42"
                            Margin="24,0,0,0"
                            Content="Start benchmark"
                            Command="{Binding StartBenchmarkCommand}"/>
                </Grid>
            </Border>

            <!-- Status -->

            <Border Grid.Row="4"
                    Margin="0,20,0,0"
                    Padding="14"
                    Background="#EEF1F5"
                    CornerRadius="6">

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Status:"
                               FontWeight="SemiBold"
                               Foreground="#465267"/>

                    <TextBlock Margin="6,0,0,0"
                               Text="{Binding Status}"
                               Foreground="#687386"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>