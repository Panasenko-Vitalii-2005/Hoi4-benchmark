<UserControl x:Class="HOI4Benchmark.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel Grid.Row="0">
    <TextBlock
        Text="{Binding Title}"
        Style="{StaticResource PageTitleTextStyle}" />

    <TextBlock
        Margin="0,8,0,0"
        Text="{Binding Subtitle}"
        Style="{StaticResource PageSubtitleTextStyle}" />
</StackPanel>

            <!-- Configuration -->

            <Border Grid.Row="1"
                    Margin="0,28,0,0"
                    Padding="24"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Benchmark configuration"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <TextBlock Margin="0,20,0,6"
                               Text="Autosave file"
                               FontWeight="SemiBold"
                               Foreground="#465267"/>

                    <TextBox Height="38"
                             Padding="10,7"
                             Text="{Binding AutosavePath,
                                    UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanStart}"/>

                    <TextBlock Margin="0,8,0,0"
                               Text="The benchmark monitors this file for stable autosave updates."
                               FontSize="12"
                               Foreground="#7A8495"/>
                </StackPanel>
            </Border>

            <!-- Session controls -->

            <Border Grid.Row="2"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#26344A"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status:"
                                       Foreground="#C8D0DC"
                                       FontWeight="SemiBold"/>

                            <TextBlock Margin="8,0,0,0"
                                       Text="{Binding StatusText}"
                                       Foreground="White"
                                       FontWeight="Bold"/>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="#C8D0DC"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="24,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Width="110"
                                Height="42"
                                Margin="0,0,10,0"
                                Content="Start"
                                Command="{Binding StartCommand}"/>

                        <Button Width="110"
                                Height="42"
                                Margin="0,0,10,0"
                                Content="Stop"
                                Command="{Binding StopCommand}"/>

                        <Button Width="110"
                                Height="42"
                                Content="Reset"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live statistics -->

            <Grid Grid.Row="3"
                  Margin="0,24,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Current game date"
                                   Foreground="#687386"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding CurrentGameDate}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E2430"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Elapsed time"
                                   Foreground="#687386"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding ElapsedTime}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E2430"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4"
                        Padding="20"
                        Background="#F7F8FA"
                        BorderBrush="#E4E8EE"
                        BorderThickness="1"
                        CornerRadius="8">

                    <StackPanel>
                        <TextBlock Text="Measurements"
                                   Foreground="#687386"/>

                        <TextBlock Margin="0,10,0,0"
                                   Text="{Binding MeasurementCount}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#1E2430"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Measurements -->

            <Border Grid.Row="4"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Measurements"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,8,0,16"
                               Text="Monthly autosave measurements appear here during the benchmark."
                               Foreground="#687386"/>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Measurements}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              MinHeight="180">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Game date"
                                                Width="*"
                                                Binding="{Binding GameDate}"/>

                            <DataGridTextColumn Header="Duration"
                                                Width="160"
                                                Binding="{Binding Duration}"/>

                            <DataGridTextColumn Header="Score"
                                                Width="140"
                                                Binding="{Binding Score}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>