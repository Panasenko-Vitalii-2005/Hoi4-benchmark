<UserControl x:Class="HOI4Benchmark.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel Grid.Row="0">
    <TextBlock
        Text="{Binding Title}"
        Style="{StaticResource PageTitleTextStyle}" />

    <TextBlock
        Margin="0,8,0,0"
        Text="{Binding Subtitle}"
        Style="{StaticResource PageSubtitleTextStyle}" />
</StackPanel>

            <!-- Autosave monitoring -->

            <Border Grid.Row="1"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Autosave monitoring"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <TextBlock Margin="0,8,0,0"
                               Text="Configure where Hearts of Iron IV autosaves are located and how often the directory is checked."
                               Foreground="#687386"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,24,0,6"
                               Text="Autosave directory"
                               FontWeight="SemiBold"
                               Foreground="#303847"/>

                    <TextBox Height="38"
                             Padding="10,7"
                             Text="{Binding AutosavePath,
                                            UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Margin="0,6,0,0"
                               Text="Enter the directory containing the Hearts of Iron IV autosave file."
                               FontSize="12"
                               Foreground="#7A8596"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,20,0,6"
                               Text="Directory check interval"
                               FontWeight="SemiBold"
                               Foreground="#303847"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Height="38"
                                 Padding="10,7"
                                 Text="{Binding MeasurementIntervalSeconds,
                                                UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="seconds"
                                   Foreground="#536074"/>
                    </Grid>

                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding IntervalValidationMessage}"
                               FontSize="12"
                               Foreground="#C13D3D"
                               TextWrapping="Wrap"/>

                    <CheckBox Margin="0,22,0,0"
                              Content="Watch autosave subdirectories"
                              IsChecked="{Binding WatchSubdirectories}"/>
                </StackPanel>
            </Border>

            <!-- Result settings -->

            <Border Grid.Row="2"
                    Margin="0,20,0,0"
                    Padding="24"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Results and export"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <TextBlock Margin="0,8,0,0"
                               Text="Control how completed benchmark sessions are stored and exported."
                               Foreground="#687386"
                               TextWrapping="Wrap"/>

                    <TextBlock Margin="0,24,0,6"
                               Text="Default export format"
                               FontWeight="SemiBold"
                               Foreground="#303847"/>

                    <ComboBox Width="220"
                              Height="38"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding SelectedExportFormat}"/>

                    <CheckBox Margin="0,22,0,0"
                              Content="Automatically save completed benchmark results"
                              IsChecked="{Binding SaveResultsAutomatically}"/>

                    <CheckBox Margin="0,14,0,0"
                              Content="Show notifications when a benchmark starts or finishes"
                              IsChecked="{Binding ShowNotifications}"/>
                </StackPanel>
            </Border>

            <!-- Actions -->

            <Border Grid.Row="3"
                    Margin="0,20,0,32"
                    Padding="18"
                    Background="#EEF1F5"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SettingsState}"
                                   FontWeight="SemiBold"
                                   Foreground="#303847"/>

                        <TextBlock Margin="0,4,20,0"
                                   Text="{Binding StatusMessage}"
                                   Foreground="#687386"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Width="130"
                                Height="40"
                                Margin="0,0,10,0"
                                Content="Reset defaults"
                                Command="{Binding ResetCommand}"/>

                        <Button Width="170"
        Height="40"
        Margin="0,0,10,0"
        Content="Create diagnostics"
        Command="{Binding CreateDiagnosticsBundleCommand}"/>

                        <Button Width="110"
                                Height="40"
                                Content="Save"
                                Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>