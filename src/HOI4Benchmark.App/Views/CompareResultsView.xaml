<UserControl
    x:Class="HOI4Benchmark.App.Views.CompareResultsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
             <RowDefinition Height="320"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel Grid.Row="0">
            <TextBlock
                Text="Compare results"
                Style="{StaticResource PageTitleTextStyle}" />

            <TextBlock
                Margin="0,8,0,0"
                Text="Select two benchmark runs to compare their performance."
                Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <!-- Result selectors -->

        <Border
            Grid.Row="1"
            Margin="0,24,0,20"
            Style="{StaticResource CardStyle}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="First result"
                        Style="{StaticResource SectionTitleTextStyle}" />

                    <ComboBox
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedFirstResult}"
                        DisplayMemberPath="DisplayName"
                        Style="{StaticResource DefaultComboBoxStyle}" />
                </StackPanel>

                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="VS" />

                <StackPanel Grid.Column="2">
                    <TextBlock
                        Margin="0,0,0,8"
                        Text="Second result"
                        Style="{StaticResource SectionTitleTextStyle}" />

                    <ComboBox
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedSecondResult}"
                        DisplayMemberPath="DisplayName"
                        Style="{StaticResource DefaultComboBoxStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Comparison -->

        <Grid Grid.Row="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Select two results to begin comparison">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSelectedResults}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid
                ItemsSource="{Binding Metrics}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeRows="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                Background="{StaticResource SurfaceBrush}"
                Foreground="{StaticResource PrimaryTextBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                RowBackground="{StaticResource SurfaceBrush}"
                AlternatingRowBackground="{StaticResource AppBackgroundBrush}">

                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSelectedResults}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Header="Metric"
                        Binding="{Binding Name}" />

                    <DataGridTemplateColumn
                        Width="*"
                        Header="First result">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding FirstValue}">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource PrimaryTextBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsFirstBetter}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource SuccessBrush}" />

                                                    <Setter
                                                        Property="FontWeight"
                                                        Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn
                        Width="*"
                        Header="Second result">

                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding SecondValue}">

                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter
                                                Property="Foreground"
                                                Value="{StaticResource PrimaryTextBrush}" />

                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding IsSecondBetter}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource SuccessBrush}" />

                                                    <Setter
                                                        Property="FontWeight"
                                                        Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="*"
                        Header="Difference"
                        Binding="{Binding Difference}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,12,0,0"
                Padding="14,10"
                Background="{StaticResource DangerBrush}"
                CornerRadius="6"
                Visibility="{Binding HasError,
                    Converter={StaticResource BooleanToVisibilityConverter}}">

                <TextBlock
                    Foreground="White"
                    Text="{Binding ErrorMessage}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>