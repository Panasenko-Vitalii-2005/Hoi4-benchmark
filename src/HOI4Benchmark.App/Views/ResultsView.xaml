<UserControl x:Class="HOI4Benchmark.App.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled"
        CanContentScroll="False">

        <Grid Margin="32">

        <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="560"/>
    <RowDefinition Height="500"/>
</Grid.RowDefinitions>

        <!-- Header -->

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0">
    <TextBlock
        Text="{Binding Title}"
        Style="{StaticResource PageTitleTextStyle}" />

    <TextBlock
        Margin="0,8,0,0"
        Text="{Binding Subtitle}"
        Style="{StaticResource PageSubtitleTextStyle}" />
</StackPanel>

            <Button Grid.Column="1"
                    Width="110"
                    Height="38"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"/>
        </Grid>

        <!-- Actions -->

<Border Grid.Row="1"
        Margin="0,24,0,0"
        Padding="16"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

    <StackPanel>

        <!-- Selected result actions -->

        <TextBlock
            Text="Selected result"
            Style="{StaticResource SectionTitleTextStyle}" />

        <TextBlock
            Margin="0,4,0,12"
            Text="Export or delete the currently selected benchmark result."
            Style="{StaticResource PageSubtitleTextStyle}" />

        <WrapPanel>

            <Button
                Width="120"
                Height="38"
                Margin="0,0,10,0"
                Content="Export JSON"
                Command="{Binding ExportJsonCommand}" />

            <Button
                Width="120"
                Height="38"
                Margin="0,0,10,0"
                Content="Export CSV"
                Command="{Binding ExportCsvCommand}" />

            <Button
                Width="130"
                Height="38"
                Content="Delete Selected"
                Command="{Binding DeleteCommand}" />

        </WrapPanel>

        <!-- All results actions -->

        <TextBlock
            Margin="0,20,0,0"
            Text="All results"
            Style="{StaticResource SectionTitleTextStyle}" />

        <TextBlock
            Margin="0,4,0,12"
            Text="Export the complete benchmark history."
            Style="{StaticResource PageSubtitleTextStyle}" />

        <WrapPanel>

            <Button
                Width="140"
                Height="38"
                Margin="0,0,10,0"
                Content="Export All JSON"
                Command="{Binding ExportAllJsonCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />

            <Button
                Width="140"
                Height="38"
                Content="Export All CSV"
                Command="{Binding ExportAllCsvCommand}"
                Style="{StaticResource SecondaryButtonStyle}" />

        </WrapPanel>

    </StackPanel>
</Border>

<!-- Export privacy -->

<Border Grid.Row="2"
        Margin="0,12,0,0"
        Padding="16"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

    <StackPanel>

        <TextBlock
            Text="Export privacy"
            Style="{StaticResource SectionTitleTextStyle}" />

        <TextBlock
            Margin="0,4,0,12"
            Text="Choose which potentially identifying details are removed from exported files."
            Style="{StaticResource PageSubtitleTextStyle}" />

        <CheckBox
            Margin="0,0,0,8"
            Content="Anonymize result names"
            IsChecked="{Binding AnonymizeResultNames,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox
            Margin="0,0,0,8"
            Content="Exclude exact timestamps"
            IsChecked="{Binding ExcludeExactTimestamps,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />

        <CheckBox
            Content="Exclude warnings"
            IsChecked="{Binding ExcludeWarnings,
                                Mode=TwoWay,
                                UpdateSourceTrigger=PropertyChanged}" />

    </StackPanel>
</Border>

        <!-- Main content -->

        <Grid Grid.Row="3"
              Margin="0,24,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Results table -->

            <Border Grid.Column="0"
                    Padding="16"
                    Background="#F7F8FA"
                    BorderBrush="#E4E8EE"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Benchmark history"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1E2430"/>

                    <DataGrid Grid.Row="1"
                              Margin="0,16,0,0"
                              ItemsSource="{Binding Results}"
                              SelectedItem="{Binding SelectedResult}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Created"
                                                Width="150"
                                                Binding="{Binding CreatedAt}"/>

                            <DataGridTextColumn Header="Game period"
                                                Width="*"
                                                Binding="{Binding GamePeriod}"/>

                            <DataGridTextColumn Header="Duration"
                                                Width="100"
                                                Binding="{Binding Duration}"/>

                            <DataGridTextColumn Header="Months"
                                                Width="80"
                                                Binding="{Binding MeasurementCount}"/>

                            <DataGridTextColumn Header="Score"
                                                Width="90"
                                                Binding="{Binding Score}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Selected result details -->

            <!-- Selected result summary -->

<Border Grid.Column="2"
        Padding="20"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

    <Grid>

        <!-- Empty state -->

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="280">

            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter
                        Property="Visibility"
                        Value="Visible" />

                    <Style.Triggers>
                        <DataTrigger
                            Binding="{Binding HasSelectedResult}"
                            Value="True">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryTextBrush}"
                Text="No result selected" />

            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{StaticResource SecondaryTextBrush}"
                Text="Select a benchmark result from the history table to inspect its summary and performance statistics." />

        </StackPanel>

        <!-- Selected result content -->

        <StackPanel Margin="0,0,14,0">

                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter
                            Property="Visibility"
                            Value="Collapsed" />

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSelectedResult}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Header -->

                <TextBlock
                    Text="Summary"
                    Style="{StaticResource SectionTitleTextStyle}" />

                <TextBlock
                    Margin="0,4,0,0"
                    Text="Overview of the selected benchmark result."
                    Style="{StaticResource PageSubtitleTextStyle}" />

                <!-- Score -->

                <Border
                    Margin="0,18,0,0"
                    Padding="16"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">

                    <StackPanel>

                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="Benchmark score"
                            Foreground="{StaticResource SecondaryTextBrush}" />

                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Text="{Binding SelectedResult.Score,
                                           TargetNullValue=—}"
                            FontSize="34"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryTextBrush}" />

                    </StackPanel>
                </Border>

                <!-- Overview -->

                <TextBlock
                    Margin="0,20,0,0"
                    Text="Overview"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}" />

                <Separator
                    Margin="0,8,0,12"
                    Background="{StaticResource BorderBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Game period" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        MaxWidth="170"
                        HorizontalAlignment="Right"
                        TextTrimming="CharacterEllipsis"
                        TextAlignment="Right"
                        TextWrapping="Wrap"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.GamePeriod,
                                       TargetNullValue=—}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Measurements" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.MeasurementCount,
                                       TargetNullValue=—}" />
                </Grid>

                <!-- Performance -->

                <TextBlock
                    Margin="0,22,0,0"
                    Text="Performance"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrimaryTextBrush}" />

                <Separator
                    Margin="0,8,0,12"
                    Background="{StaticResource BorderBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Average month" />

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.AverageMonthTime,
                                       TargetNullValue=—}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Median month" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.MedianMonthTime,
                                       TargetNullValue=—}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Fastest month" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.FastestMonthTime,
                                       TargetNullValue=—}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Slowest month" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.SlowestMonthTime,
                                       TargetNullValue=—}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,12,0,0"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        Text="Standard deviation" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="16,12,0,0"
                        HorizontalAlignment="Right"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        Text="{Binding SelectedResult.StandardDeviation,
                                       TargetNullValue=—}" />

                </Grid>
        </StackPanel>

    </Grid>
</Border>
        </Grid>

        <!-- Status -->

       <Border Grid.Row="4"
        Margin="0,24,0,24"
        Padding="20"
        Background="{StaticResource SurfaceBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="400"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Text="Monthly performance"
                Style="{StaticResource SectionTitleTextStyle}"/>

            <TextBlock
                Margin="0,6,0,0"
                Text="Time required to process each measured in-game month."
                Style="{StaticResource PageSubtitleTextStyle}"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,18,0,0">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Select a benchmark result with measurement data."
                Foreground="{StaticResource SecondaryTextBrush}">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter
                            Property="Visibility"
                            Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSelectedResult}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <lvc:CartesianChart
    Height="390"
    MinHeight="390"
    Margin="0,0,0,8"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Top"
    Series="{Binding MonthlySeries}"
    XAxes="{Binding MonthlyXAxes}"
    YAxes="{Binding MonthlyYAxes}"
    LegendPosition="Top">

                <lvc:CartesianChart.Style>
                    <Style TargetType="lvc:CartesianChart">
                        <Setter
                            Property="Visibility"
                            Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger
                                Binding="{Binding HasSelectedResult}"
                                Value="True">

                                <Setter
                                    Property="Visibility"
                                    Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </lvc:CartesianChart.Style>
            </lvc:CartesianChart>
        </Grid>
    </Grid>
</Border>
    </Grid>
    </ScrollViewer>
</UserControl>