<Window x:Class="HOI4Benchmark.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOI4 Benchmark"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="24,28,24,32">
                    <TextBlock Text="HOI4"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="30"
                               FontWeight="Bold"/>

                    <TextBlock Text="Benchmark"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="18"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="12,0">

                    <Button Content="Dashboard"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateDashboardCommand}"/>

                    <Button Content="Benchmark"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateBenchmarkCommand}"/>

                    <Button Content="Results"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateResultsCommand}"/>

                    <Button Content="Settings"
                            Style="{StaticResource NavigationButtonStyle}"
                            Command="{Binding NavigateSettingsCommand}"/>

                    <Button
    Content="Compare results"
    Command="{Binding NavigateCompareResultsCommand}"
    Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Margin="24"
                           Foreground="{StaticResource DisabledTextBrush}"
                           Text="MVP 0.1"/>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="24"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">

            <ContentControl Content="{Binding CurrentView}"/>
        </Border>
    </Grid>
</Window>